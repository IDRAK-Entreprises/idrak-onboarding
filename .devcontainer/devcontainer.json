{
  "name": "IDRAK Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000, 3000],
  "postCreateCommand": "echo 'Ready! Run your FastAPI backend on :8000 and Vue/Next.js frontend on :3000'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
